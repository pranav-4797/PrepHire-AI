rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return signedIn() ? profile().role : null;
    }

    function isAdmin() {
      return role() == 'Admin' || role() == 'admin';
    }

    function isFaculty() {
      return role() == 'Faculty' || role() == 'faculty';
    }

    function isStudent() {
      return role() == 'Student' || role() == 'student';
    }

    match /users/{userId} {
      // A new account can only ever create itself as a Student, never-disabled.
      // Promotion to Faculty/Admin can only happen via an existing Admin's
      // `update` below — never at signup, and never by the user themselves.
      allow create: if signedIn() && request.auth.uid == userId &&
        (request.resource.data.role == 'Student' || request.resource.data.role == 'student') &&
        request.resource.data.disabled == false;
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin() || isFaculty());
      allow update: if signedIn() && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).changedKeys().hasAny(['role', 'disabled', 'department'])
        )
      );
      allow delete: if signedIn() && isAdmin();
    }

    match /sessions/{sessionId} {
      allow create: if signedIn() && (
        isAdmin() ||
        isFaculty() ||
        (isStudent() && request.resource.data.studentEmail == request.auth.token.email)
      );
      allow read: if signedIn() && (
        isAdmin() ||
        (isFaculty() && resource.data.department == profile().department) ||
        (isStudent() && resource.data.studentEmail == request.auth.token.email)
      );
      allow update: if signedIn() && (
        isAdmin() ||
        (isFaculty() && resource.data.department == profile().department)
      );
      allow delete: if signedIn() && isAdmin();
    }

    match /courses/{courseId} {
      allow read: if signedIn();
      allow write: if signedIn() && (isAdmin() || isFaculty());
    }

    match /feedback/{feedbackId} {
      allow create: if signedIn() && request.resource.data.userEmail == request.auth.token.email;
      allow read: if signedIn() && isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
