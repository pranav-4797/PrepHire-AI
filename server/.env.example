PORT=3001
CORS_ORIGIN=http://localhost:5173
GOOGLE_SHARED_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT=
VITE_FIREBASE_PROJECT_ID=
VIDEO_RETENTION_DAYS=7

# Google Gemini API key — used ONLY server-side by /api/ai/generate (resume
# parsing + interview question generation). Deliberately NOT prefixed with
# VITE_: a VITE_ prefix means Vite bundles it into the client JS, which is
# how this used to leak. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Online Coding Platform — Sandboxed Code Execution Service.
# Configurable providers: 'auto' | 'judge0' | 'piston' | 'local'
# Defaults to 'auto': attempts Judge0 first (CodeChef-grade CE / self-hosted container),
# falls back to Piston, and provides native toolchains (g++, gcc, python, node) for offline resilience.
JUDGE_PROVIDER=auto

# Judge0 configuration:
# - Free public CE instance: https://ce.judge0.com (default)
# - Self-hosted Judge0 via Docker: http://localhost:2358 (or http://judge0:2358)
# - RapidAPI Judge0: https://judge0-ce.p.rapidapi.com
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=
JUDGE0_AUTH_TOKEN=

# Piston configuration (legacy fallback / alternative provider)
PISTON_API_URL=https://emkc.org/api/v2/piston

# NVIDIA NIM API key — used server-side by /api/coding/generate-problem
# for automated competitive programming assignment creation with sandbox pre-validation.
# Get an API key at https://build.nvidia.com (NVIDIA API Catalog).
# Defaults to qwen/qwen2.5-coder-32b-instruct. Falls back to GEMINI_API_KEY if unset.
NVIDIA_API_KEY=
NVIDIA_MODEL=qwen/qwen2.5-coder-32b-instruct


